import random
import string
import json

def generate_account_data():
    """Generates secure account data with separated passwords."""
    print("\n--- Account Generator ---")
    
    chars = string.ascii_letters + string.digits + "!@#$%^&*"
    
    email_pass = ''.join(random.choice(chars) for _ in range(12))
    service_pass = ''.join(random.choice(chars) for _ in range(16))
    
    account_data = {
        "username": "admin_user",
        "email": "admin@example.com",
        "password": email_pass,        # Password for email access
        "pp_password": service_pass    # Separate password for the service
    }
    
    print("[+] Generated credentials:")
    print(json.dumps(account_data, indent=4))
    print("--------------------------")
import socket

def check_port():
    """Checks TCP port availability on a given host."""
    print("\n--- Port Scanner ---")
    host = input("Enter IP or domain (e.g., 8.8.8.8): ")
    port_str = input("Enter port (e.g., 22 for SSH): ")
    
    try:
        port = int(port_str)
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(2)
        
        result = sock.connect_ex((host, port))
        if result == 0:
            print(f"[+] Success: Port {port} on {host} is OPEN.")
        else:
            print(f"[-] Error: Port {port} on {host} is CLOSED or unreachable.")
        sock.close()
    except ValueError:
        print("[-] Error: Port must be a number.")
    except Exception as e:
        print(f"[-] An error occurred: {e}")
    print("---------------------")
